---
layout: default
---

{% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign cv_url = page.cv_pdf %}
  {% else %}
    {% assign cv_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
  {% endif %}

  <div class="cv-actions">
    <a href="{{ cv_url }}" target="_blank" rel="noopener noreferrer" class="cv-button">
      <i class="fa-solid fa-file-pdf"></i>
      View CV (PDF)
    </a>
  </div>
  
  <div class="cv-embed">
    <iframe src="{{ cv_url }}" title="CV" style="border:none;"></iframe>
  </div>
{% else %}
  <p>No CV pdf uploaded yet. Hang tight!</p>
{% endif %}
