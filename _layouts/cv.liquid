---
layout: default
---

{% if page.cv_pdf %}
<div style="text-align: center; max-width: 95%; margin: 0 auto;">
<iframe 
  {% if page.cv_pdf contains '://' %}
    src="{{ page.cv_pdf }}"
  {% else %}
    src="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
  {% endif %}
  width="100%" height="900px" 
  style="border:none; display: block; margin: 0 auto;">
  This browser does not support PDFs. Please download the PDF to view it: <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}">Download CV</a>

</iframe>
</div>
{% else %}
<p>No CV pdf uploaded yet. Hang tight!</p>

{% endif %}